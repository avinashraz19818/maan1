RewriteEngine On

# ---------- MIME types (images) ----------
# Server agar image ko octet-stream bheje to browser render karta hi nahi.
<IfModule mime_module>
  AddType image/webp  .webp
  AddType image/png   .png
  AddType image/jpeg  .jpg .jpeg
  AddType image/gif   .gif
  AddType image/avif  .avif
  AddType image/bmp   .bmp
  AddType image/x-icon .ico
  AddType image/vnd.microsoft.icon .ico
  AddType image/svg+xml .svg
</IfModule>

# Images par nosniff hatao (backup safety)
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|avif|bmp)$">
    Header always unset X-Content-Type-Options
    Header unset X-Content-Type-Options
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|woff2?|ttf|png|jpe?g|gif|svg|ico|json|webp)$">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, OPTIONS"
  </FilesMatch>
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Pass Authorization to PHP (Apache / LiteSpeed)
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# /web/config → PHP shim
RewriteRule ^web/config/?$ web/config.php [L,QSA]

# ---------------------------------------------------------------------------
# Same-origin LOCAL PHP API  ->  /api/Controller/Action  ->  api/_router.php
# (yahi aapke cPanel MySQL me login/register karta hai)
#
# BUG FIX: pehle yaha "RewriteRule ^api(/.*)?$ api_proxy.php [L,QSA]" tha.
# api_proxy.php har /api request ko https://maanwin16.com (dusre server) par
# bhej deta tha, isliye:
#   * register successful dikhta tha, par user aapke database/admin me nahi aata tha
#   * database me maujood user login par "wrong password / user not found" deta tha
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/([A-Za-z0-9_]+)/([A-Za-z0-9_]+)/?$ api/_router.php?path=$1/$2 [L,QSA]

# Deep/extra API paths (3+ segments) bhi local router par bhejo
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/([A-Za-z0-9_/]+?)/?$ api/_router.php?path=$1 [L,QSA]

# Remote upstream proxy — DISABLED.
# Sirf tab enable karein jab aap jaan-boojh kar dusre server ka API chahte hain:
# RewriteRule ^api(/.*)?$ api_proxy.php [L,QSA]

# Live lottery issue JSON (do not use stale webapi/kv/issue/*.html)
RewriteRule ^webapi/kv/issue/([A-Za-z0-9_]+)/?$ webapi_proxy.php [L,QSA]

# Same-origin lottery draw history JSON
RewriteRule ^lottery-draw(/.*)?$ lottery_draw_proxy.php [L,QSA]

# Tenant images: local file if present, else CDN proxy
RewriteCond %{REQUEST_URI} ^/img/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^img/ img_proxy.php [L,QSA]

# Missing skin/VIP assets from live Maanwin (local file still wins via -f below)
RewriteCond %{REQUEST_URI} ^/assets/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^assets/ assets_proxy.php [L,QSA]

# Frontend lottery JSON: /{Lottery}/{gameCode}.json  aur
# /{Lottery}/{gameCode}/GetHistoryIssuePage.json
# (maan1 me inka route hi nahi tha -> index.html serve ho raha tha)
RewriteRule ^(WinGo|TrxWinGo|VideoWinGo|K3|D5|5D|MotoRace|MotoRacing)/([A-Za-z0-9_]+)/GetHistoryIssuePage\.json$ lottery_issue_proxy.php [L,QSA,NC]
RewriteRule ^(WinGo|TrxWinGo|VideoWinGo|K3|D5|5D|MotoRace|MotoRacing)/([A-Za-z0-9_]+)\.json$ lottery_issue_proxy.php [L,QSA,NC]

# Real files and folders (assets, css, js, img, webapi, /pay) stay as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Missing hashed assets must 404 — never serve index.html as a fake file
RewriteCond %{REQUEST_URI} ^/(assets|css|js|img|images|webapi)/
RewriteRule ^ - [L]

# Vue SPA history routes fallback
RewriteRule ^ index.html [L]
